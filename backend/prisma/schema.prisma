generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id                  String   @id @default(uuid())
  
  // Personal Info
  fullName            String
  fatherName          String?
  dob                 String?
  age                 String?
  gender              String?
  occupation          String?
  annualIncome        String?
  category            String?
  mobileNumber        String?
  whatsappNumber      String?
  alternateMobile     String?
  email               String?

  // Address
  houseNo             String?
  street              String?
  village             String?
  mandal              String?
  district            String?
  state               String?
  pinCode             String?
  address             String? 
  location            String? 
  
  // KYC & Bank
  aadhaarNumber       String?
  panNumber           String?
  form60              Boolean? @default(false)
  bankName            String?
  accountHolder       String?
  accountNumber       String?
  ifscCode            String?
  bankBranch          String?

  // Membership Details
  membershipType      String?  @default("Regular Member")
  membershipFee       String?  @default("20")
  shareCapital        String?  @default("100")
  totalAmount         String?  @default("120")
  paymentStatus       String   @default("Pending")
  paymentMethod       String?
  transactionId       String?
  paymentDate         DateTime?

  // Nominee Details
  nomineeName         String?
  nomineeRelationship String?
  nomineeDob          String?
  nomineeMobile       String?
  nomineeAadhaar      String?
  nomineeAddress      String?
  nomineeShare        String?

  // Introducer Details
  introducerName      String?
  introducerMemberId  String?
  introducerMobile    String?

  // Documents
  photoUrl            String?
  aadhaarUrl          String?
  panUrl              String?
  addressProofUrl     String?
  signatureUrl        String?
  declarationAccepted Boolean? @default(false)

  phone               String? 
  memberId            String?

  // Admin Tracking
  kycStatus           String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  applicationStatus   String   @default("PENDING") // PENDING, APPROVED, REJECTED, REQUEST_MORE_DOCUMENTS
  verificationNotes   String?  @db.Text
  rejectionReason     String?  @db.Text
  requestMoreDocsReason String? @db.Text
  lastUpdatedBy       String?  @default("Admin")

  events              MemberTimelineEvent[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MemberTimelineEvent {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("SYSTEM") // e.g. STATUS, DOCUMENT, SYSTEM
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  category    String
  emoji       String?  // e.g., "🍯"
  titlePrefix String?  // e.g., "Pure Wild"
  tagline     String?  // e.g., "Wild-sourced, unprocessed, untouched by chemicals."
  heroBg      String?  // CSS gradient string
  badgeLabel  String?  // e.g., "Wild Sourced · Unprocessed"
  mainImg     String   // URL to asset
  description String   @db.Text
  extraInfo   String?  @db.Text
  features    Json?    // changed from String[] for MySQL compatibility
  price       Int      @default(0)
  rating      Float    @default(0)
  reviews     Int      @default(0)
  farmerInfo  String?
  badge       String?  // e.g., "Certified Organic"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  emoji       String?  // e.g., "🌱"
  heroBg      String?  // CSS gradient
  badgeLabel  String?  // e.g., "Sustainable · Community"
  mainImg     String?  // URL
  status      String   // e.g., "ongoing", "completed"
  progress    Int      @default(0) // Percentage
  description String   @db.Text
  vision      String?  @db.Text
  richContent String?  @db.Text // JSON or structured string for detailed sections
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  location    String?
  plan        String
  amount      String?
  contactTime String?
  message     String?
  status      String   @default("New") // "New", "Contacted", "Converted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  productName String
  customerName String
  phone       String
  amount      Int
  status      String   @default("Pending") // "Pending", "Completed", "Cancelled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceRequest {
  id              String   @id @default(uuid())
  fullName        String
  mobile          String
  email           String?
  serviceCategory String?
  selectedService String
  notes           String?  @db.Text
  status          String   @default("New") // "New", "In Progress", "Completed", "Rejected"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Leadership {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String   @db.Text
  image     String   // URL
  socials   Json?    // { linkedin: string, twitter: string }
  order     Int      @default(0) // For sorting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialSchemeEnquiry {
  id               String   @id @default(uuid())
  fullName         String
  phoneNumber      String
  email            String
  city             String
  investmentAmount String
  selectedScheme   String
  message          String?  @db.Text
  createdAt        DateTime @default(now())
}

model AdminUser {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String    // Bcrypt hashed password
  name        String?   @default("Admin")
  role        String    @default("ADMIN")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactRequest {
  id           String   @id @default(uuid())
  name         String
  email        String
  mobileNumber String
  subject      String
  message      String   @db.Text
  createdAt    DateTime @default(now())
}

model EducationEnquiry {
  id               String   @id @default(uuid())
  fullName         String
  mobileNumber     String
  email            String
  qualification    String
  course           String
  preferredMode    String
  status           String   @default("New") // "New", "Contacted", "Enrolled", "Closed"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
}

model BusinessConsultancyEnquiry {
  id                  String   @id @default(uuid())
  businessName        String
  contactPerson       String
  mobile              String
  email               String
  industry            String
  serviceRequired     String
  businessDescription String?  @db.Text
  status              String   @default("New") // "New", "Contacted", "In Progress", "Closed"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([createdAt])
}

model CooperativeTradingEnquiry {
  id              String   @id @default(uuid())
  fullName        String
  businessName    String
  mobileNumber    String
  email           String
  category        String
  memberId        String?
  message         String?  @db.Text
  status          String   @default("New") // "New", "Contacted", "In Progress", "Closed"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}
