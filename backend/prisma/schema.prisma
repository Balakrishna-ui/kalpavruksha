generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id             String   @id @default(uuid())
  fullName       String
  fatherName     String?
  email          String?
  phone          String?
  mobileNumber   String?
  address        String?
  location       String?
  district       String?
  membershipType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  category    String
  emoji       String?  // e.g., "🍯"
  titlePrefix String?  // e.g., "Pure Wild"
  tagline     String?  // e.g., "Wild-sourced, unprocessed, untouched by chemicals."
  heroBg      String?  // CSS gradient string
  badgeLabel  String?  // e.g., "Wild Sourced · Unprocessed"
  mainImg     String   // URL to asset
  description String   @db.Text
  extraInfo   String?  @db.Text
  features    String[] // array of feature strings like ["No Artificial Ripening"]
  price       Int      @default(0)
  rating      Float    @default(0)
  reviews     Int      @default(0)
  farmerInfo  String?
  badge       String?  // e.g., "Certified Organic"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  emoji       String?  // e.g., "🌱"
  heroBg      String?  // CSS gradient
  badgeLabel  String?  // e.g., "Sustainable · Community"
  mainImg     String?  // URL
  status      String   // e.g., "ongoing", "completed"
  progress    Int      @default(0) // Percentage
  description String   @db.Text
  vision      String?  @db.Text
  richContent String?  @db.Text // JSON or structured string for detailed sections
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  location    String?
  plan        String
  amount      String?
  contactTime String?
  message     String?
  status      String   @default("New") // "New", "Contacted", "Converted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  productName String
  customerName String
  phone       String
  amount      Int
  status      String   @default("Pending") // "Pending", "Completed", "Cancelled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceRequest {
  id              String   @id @default(uuid())
  fullName        String
  mobile          String
  email           String?
  serviceCategory String?
  selectedService String
  notes           String?  @db.Text
  status          String   @default("New") // "New", "In Progress", "Completed", "Rejected"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Leadership {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String   @db.Text
  image     String   // URL
  socials   Json?    // { linkedin: string, twitter: string }
  order     Int      @default(0) // For sorting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialSchemeEnquiry {
  id               String   @id @default(uuid())
  fullName         String
  phoneNumber      String
  email            String
  city             String
  investmentAmount String
  selectedScheme   String
  message          String?  @db.Text
  createdAt        DateTime @default(now())
}
